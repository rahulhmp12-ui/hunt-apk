<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_hunt_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp"
            android:background="@drawable/bg_hunt_panel">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HUNT  /  CYBER SPACE"
                android:textColor="#66D9FF"
                android:textSize="12sp"
                android:letterSpacing="0.12"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="HUNT"
                android:textColor="#FFFFFF"
                android:textSize="36sp"
                android:textStyle="bold"
                android:letterSpacing="0.10"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="YOUR COMMAND CENTER"
                android:textColor="#9BB6DA"
                android:textSize="12sp"
                android:letterSpacing="0.15"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:padding="9dp"
                android:background="@drawable/bg_hunt_button_secondary"
                android:text="●  SYSTEM READY"
                android:textColor="#65E8C1"
                android:textSize="11sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="12dp"
            android:text="HUNT MODULES"
            android:textColor="#75CFFF"
            android:textSize="13sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btnRecon"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_hunt_button"
            android:text="01  RECON"
            android:textColor="#FFFFFF"/>

        <Button
            android:id="@+id/btnWeb"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_hunt_button_secondary"
            android:text="02  WEB SCANNER"
            android:textColor="#FFFFFF"/>

        <Button
            android:id="@+id/btnPassword"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_hunt_button_secondary"
            android:text="03  PASSWORD"
            android:textColor="#FFFFFF"/>

        <Button
            android:id="@+id/btnAuto"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_hunt_button"
            android:text="04  FULL AUTO"
            android:textColor="#FFFFFF"/>

        <Button
            android:id="@+id/btnResults"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_hunt_button_secondary"
            android:text="05  RESULTS"
            android:textColor="#FFFFFF"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="COMMAND CONSOLE"
            android:textColor="#75CFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.10"/>

        <EditText
            android:id="@+id/input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="58dp"
            android:padding="16dp"
            android:hint="Enter your command..."
            android:textColor="#FFFFFF"
            android:textColorHint="#8194B2"
            android:background="@drawable/bg_hunt_input"
            android:importantForAutofill="no"
            android:inputType="text"
            android:singleLine="false"
            android:typeface="monospace"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_hunt_button_secondary"
                android:text="SAVE COMMAND"
                android:textColor="#FFFFFF"
                android:textSize="11sp"/>

            <Button
                android:id="@+id/btnRunNow"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_hunt_button"
                android:text="▶ RUN NOW"
                android:textColor="#FFFFFF"
                android:textSize="11sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/bg_hunt_panel">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SYSTEM TOOLS"
                android:textColor="#75CFFF"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <Button
                android:id="@+id/btnSetup"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_hunt_button"
                android:text="⚙  PREPARE TERMUX"
                android:textColor="#FFFFFF"/>

            <Button
                android:id="@+id/btnOpen"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_hunt_button_secondary"
                android:text="OPEN TERMUX"
                android:textColor="#FFFFFF"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/bg_hunt_panel">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SAVED COMMANDS"
                android:textColor="#75CFFF"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Tap to run • Long press to delete"
                android:textColor="#8FA4C3"
                android:textSize="11sp"/>

            <LinearLayout
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="HUNT CYBER TOOLS"
            android:textColor="#526B91"
            android:textSize="10sp"
            android:letterSpacing="0.15"/>

    </LinearLayout>
</ScrollView>
